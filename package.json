{
  "name": "teams-cli",
  "version": "0.1.0",
  "description": "TypeScript CLI for Microsoft Teams via captured Outlook-web Bearer token. Mirrors outlook-cli.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/cli.js",
  "bin": {
    "teams-cli": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepare": "[ -d src ] && npm run build || true",
    "cli": "ts-node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "optionalDependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
